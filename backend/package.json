{
  "name": "backend",
  "version": "0.2.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "Elastic-2.0",
  "scripts": {
    "build": "pnpm --filter api-schemas build && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"eslint.config.mjs\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "create-instance-organization": "node dist/commands/create-instance-organization.js",
    "set-instance-mode": "node dist/commands/set-instance-mode.js",
    "hosted-traefik-config": "node dist/commands/hosted-traefik-config.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "openapi:generate": "ts-node -T -P tsconfig.json scripts/generate-openapi.ts",
    "opentofu:schemas": "ts-node -T -P tsconfig.json scripts/provider-schemas.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx,js}\" \"eslint.config.mjs\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.{ts,tsx,js}\" \"eslint.config.mjs\" --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:db": "jest --config ./test/jest-db.json",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:moto": "jest --config ./test/jest-moto.json --runInBand",
    "test:google-validate": "jest --config ./test/jest-validate.json --runInBand"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.20",
    "@ai-sdk/azure": "^4.0.21",
    "@ai-sdk/cohere": "^4.0.12",
    "@ai-sdk/deepinfra": "^3.0.14",
    "@ai-sdk/mistral": "^4.0.14",
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@aws-sdk/client-acm": "3.1143.0",
    "@aws-sdk/client-cloudfront": "3.1143.0",
    "@aws-sdk/client-cloudwatch-logs": "3.1143.0",
    "@aws-sdk/client-codebuild": "3.1143.0",
    "@aws-sdk/client-ec2": "3.1143.0",
    "@aws-sdk/client-ecr": "3.1143.0",
    "@aws-sdk/client-ecs": "3.1143.0",
    "@aws-sdk/client-elasticache": "3.1143.0",
    "@aws-sdk/client-iam": "3.1143.0",
    "@aws-sdk/client-rds": "3.1143.0",
    "@aws-sdk/client-resource-groups-tagging-api": "3.1143.0",
    "@aws-sdk/client-s3": "3.1143.0",
    "@aws-sdk/client-ssm": "3.1143.0",
    "@aws-sdk/client-sts": "3.1143.0",
    "@better-auth/api-key": "1.6.33",
    "@better-auth/scim": "1.6.33",
    "@better-auth/sso": "1.6.33",
    "@faker-js/faker": "^8.4.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/websockets": "^11.1.28",
    "@octokit/auth-app": "^8.2.0",
    "@react-email/components": "^1.0.12",
    "ai": "^7.0.37",
    "ai-sdk-ollama": "^4.0.0",
    "api-schemas": "workspace:*",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.6.33",
    "croner": "^10.0.1",
    "date-fns": "^4.4.0",
    "dockerode": "^5.0.1",
    "drizzle-orm": "^0.45.2",
    "gpt-tokenizer": "3.4.0",
    "multer": "^2.2.0",
    "nanoid": "^3.3.16",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.4.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^9.0.3",
    "octokit": "^5.0.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "react": "19.2.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.18.0",
    "rxjs": "^7.8.1",
    "semver": "^7.8.5",
    "shell-quote": "^1.10.0",
    "slugify": "^1.6.9",
    "ssh2": "^1.17.0",
    "stripe": "^22.3.2",
    "undici": "7.28.0",
    "ws": "8.21.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@testcontainers/postgresql": "^12.0.4",
    "@types/dockerode": "^4.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/semver": "^7.7.1",
    "@types/shell-quote": "^1.7.5",
    "@types/ssh2": "^1.15.5",
    "@types/supertest": "^7.0.0",
    "@types/ws": "^8.18.1",
    "ajv": "^8.20.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "mjs",
      "json",
      "ts",
      "tsx"
    ],
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/test/harness\\.spec\\.ts$",
      "<rootDir>/test/common/trust-proxy\\.spec\\.ts$",
      "<rootDir>/test/db/columns\\.spec\\.ts$"
    ],
    "transform": {
      "^.+\\.(t|j)sx?$": "ts-jest",
      "^.+\\.(m|c)js$": [
        "ts-jest",
        {
          "diagnostics": false,
          "tsconfig": {
            "allowJs": true,
            "module": "commonjs",
            "esModuleInterop": true,
            "target": "es2022",
            "skipLibCheck": true
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!.*\\.mjs$)(?!.*(@noble|nanostores|jose|kysely|octokit|universal-user-agent|universal-github-app-jwt|before-after-hook|@react-email|ai|@ai-sdk|ai-sdk-ollama|@workflow)[+/@])"
    ],
    "resolver": "<rootDir>/test/octokit-resolver.js",
    "globalSetup": "<rootDir>/test/utils/unit-global-setup.ts",
    "globalTeardown": "<rootDir>/test/utils/unit-global-teardown.ts",
    "reporters": [
      "default",
      [
        "<rootDir>/test/utils/heartbeat-reporter.js",
        {
          "lane": "unit",
          "progressLines": false
        }
      ]
    ],
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "testTimeout": 60000,
    "maxWorkers": "50%"
  }
}
