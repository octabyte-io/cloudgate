DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudgate
PORT=4000
# 32+ chars; generate with: openssl rand -hex 32
APP_ENCRYPTION_SECRET=
# 32+ chars; generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
# The dashboard's public origin. better-auth trusts this origin and generates
# its links against it, so point it at the frontend, not at this service — the
# frontend proxies /api/auth/* through to here (frontend/src/lib/config.ts).
# Without it, every browser sign-in is refused with "Invalid origin".
BETTER_AUTH_URL=http://localhost:3000
# Further origins a browser may sign in from, comma-separated — a staging host, a
# LAN address alongside localhost, a client that does not proxy /api/auth/*.
# Each has to be scheme and host only, with no path or trailing slash.
#TRUSTED_ORIGINS=https://console.example.com,http://192.168.1.20:3000
# Origins allowed to call this API from a browser, comma-separated. Unset means
# none, which is the normal case: the frontend proxies /api/auth/* and /backend/*
# through its own origin (frontend/next.config.ts), so the browser never makes a
# cross-origin request and CORS never applies. Every origin has to be named —
# a wildcard is not legal alongside the session cookie's credentials.
#CORS_ALLOWED_ORIGINS=https://console.example.com,https://ops.example.com
# This API's own public origin (the console's CLOUDGATE_API_URL too). Advertised
# by the public GET /settings/about so the Cloudgate CLI can dial the WebSockets
# the console does not proxy; unset, the CLI cannot stream logs.
#CLOUDGATE_API_URL=http://localhost:4000
# Transactional mail (optional) — smtp or resend
#MAIL_PROVIDER=smtp
#MAIL_FROM_ADDRESS=noreply@example.com
#SMTP_SERVER=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#RESEND_API_KEY=
# Docker image tag this instance runs (update checks / reload-server)
#RELEASE_TAG=latest
# Where this instance keeps its own files: deployment logs, application and
# compose source trees, monitoring series, SSH keys, Traefik config, schedules.
# /etc/cloudgate by default, which no ordinary user can create — point it
# somewhere writable and no sudo is needed to deploy, stream a log or open the
# stats socket. Must be an absolute path other than /.
# Servers you add keep their own /etc/cloudgate, created by the setup script, so
# this only moves the tree on the host the backend runs on.
#CLOUDGATE_DIRECTORY=/etc/cloudgate
# Ports/version for the platform's own Traefik (settings traefik setup)
#TRAEFIK_PORT=80
#TRAEFIK_SSL_PORT=443
#TRAEFIK_HTTP3_PORT=443
#TRAEFIK_VERSION=3.6.7
