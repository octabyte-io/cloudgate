# Where the Cloudgate backend listens. `pnpm dev:backend` uses 4000 unless PORT
# says otherwise (backend/src/main.ts).
#
# The browser never calls this origin over HTTP: next.config.ts rewrites
# /api/auth/* and /backend/* onto it so requests stay same-origin and the
# session cookie travels. WebSocket gateways are dialled here directly, with
# http: swapped for ws: (src/lib/config.ts).
#
# Read when the console starts, never at build time, and handed to each page
# by the root layout (ADR-0082): changing it is a restart. `next dev` uses
# http://localhost:4000 when it is unset; a built console (`pnpm start`) refuses
# to start without it.
CLOUDGATE_API_URL=http://localhost:4000

# The backend needs one setting for any of this to work. In backend/.env:
#
#   BETTER_AUTH_URL=http://localhost:3000
#
# better-auth refuses a request from an Origin it does not trust. BETTER_AUTH_URL
# is trusted for free, so pointing it at this app is the arrangement that needs
# nothing else — and it is also the origin every link better-auth mails out
# resolves on. A browser signing in from somewhere else is possible: name that
# origin in the backend's TRUSTED_ORIGINS as well.
