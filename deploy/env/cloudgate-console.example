# /etc/default/cloudgate-console — mode 0640, root:cloudgate
#
# `deploy/install.sh` generates this file.
#
# NEXT_PUBLIC_API_URL is the only variable the frontend reads, and it is read
# twice: inlined into the client bundle at BUILD time, and read at runtime by
# next.config.ts for the /api/auth/* and /backend/* rewrites.
#
# That means changing it is a REBUILD, not a restart. Build the console without
# it and everything appears to work — the page loads, sign-in succeeds, REST
# works through the runtime rewrite — while every websocket feed dials
# ws://localhost:4000 from the operator's own browser, forever.
#
# It must start with http:// or https:// or the build throws at module load
# (frontend/src/lib/config.ts).
#
# Console and API deliberately share one hostname. The session cookie is
# host-only (useSecureCookies: false, no domain) and a browser cannot set
# headers on a WebSocket, so the six gateways authenticate by cookie alone.
# Cookies ignore port but not host: two hostnames means sign-in and REST work
# while every live feed closes silently.

# BACKEND_INTERNAL_ORIGIN is where the console's own rewrites reach the API.
# Server-side only — no browser dials it — so it is loopback, and unlike
# NEXT_PUBLIC_API_URL it is not inlined into the client bundle. It is read at
# BUILD time as well as at runtime, because rewrite destinations are baked into
# the routes manifest: export it for `next build` too, or the built console goes
# on proxying to NEXT_PUBLIC_API_URL. Unset, it falls back to
# NEXT_PUBLIC_API_URL, which is what every install did before.

# CONSOLE_TRUSTED_PROXY — Hosted instance only: one address or CIDR
# range, the docker_gwbridge subnet Traefik reaches the console from. A request
# from inside it keeps the last x-forwarded-for entry (the browser, as Traefik
# saw it); every other request has its chain replaced by its socket peer.
# Unset on a Self-hosted install, where nothing sits in front of the console.
# A value that is not an address or range stops the console at boot.

NODE_ENV=production
PORT=3000
NEXT_PUBLIC_API_URL=http://<public-host>:4000
BACKEND_INTERNAL_ORIGIN=http://127.0.0.1:4000
