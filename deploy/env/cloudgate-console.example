# /etc/default/cloudgate-console — mode 0640, root:cloudgate
#
# `deploy/install.sh` generates this file.
#
# CLOUDGATE_API_URL is the API's public origin, the one the browser dials the
# six websocket gateways on. The console reads it when it STARTS, not when it
# is built, and hands it to every page (ADR-0082): one build serves any
# address, and changing it is a restart:
#
#   systemctl restart cloudgate-console
#
# It must be set, and start with http:// or https://, or the console stops at
# boot with a sentence naming it (frontend/server/api-origin.mjs). The backend
# advertises the same value under the same name in
# /etc/default/cloudgate-backend; move the API and change both.
#
# Console and API deliberately share one hostname. The session cookie is
# host-only (useSecureCookies: false, no domain) and a browser cannot set
# headers on a WebSocket, so the six gateways authenticate by cookie alone.
# Cookies ignore port but not host: two hostnames means sign-in and REST work
# while every live feed closes silently.

# BACKEND_INTERNAL_ORIGIN is where the console's own rewrites reach the API.
# Server-side only — no browser dials it — so it is loopback. Unlike
# CLOUDGATE_API_URL it is read only when the console is BUILT: rewrite
# destinations are written into the routes manifest by `next build`, and the
# running console takes them from there. A Cloudgate version is built against
# http://127.0.0.1:4000 (deploy/version-tarball.sh), so changing the value
# here changes nothing; it is written for whoever builds from source, who must
# export it for `next build`. Unset, it is http://localhost:4000.

# CONSOLE_TRUSTED_PROXY — Hosted instance only: one address or CIDR
# range, the docker_gwbridge subnet Traefik reaches the console from. A request
# from inside it keeps the last x-forwarded-for entry (the browser, as Traefik
# saw it); every other request has its chain replaced by its socket peer.
# Unset on a Self-hosted install, where nothing sits in front of the console.
# A value that is not an address or range stops the console at boot.

NODE_ENV=production
PORT=3000
CLOUDGATE_API_URL=http://<public-host>:4000
BACKEND_INTERNAL_ORIGIN=http://127.0.0.1:4000
